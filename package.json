{
  "name": "controle-financeiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App pessoal de controle financeiro — limitador de gastos por ciclo. Fase 0 + Fase 1 (motor de cálculo).",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-owner": "tsx --env-file=.env prisma/seed-owner.ts",
    "verificar:isolamento": "tsx --env-file=.env scripts/verificar-isolamento.ts",
    "projetar": "tsx --env-file=.env scripts/projetar.ts",
    "ia:verificar": "tsx --env-file=.env scripts/verificar-capacidade-ia.ts",
    "db:studio": "prisma studio",
    "senha:redefinir": "tsx --env-file=.env scripts/redefinir-senha.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "openai": "^7.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
