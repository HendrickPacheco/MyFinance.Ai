# PostgreSQL local (o app é single-user e roda na sua máquina).
# Instalação via Homebrew: `brew install postgresql@16 && brew services start postgresql@16`
# Criação do banco: `createdb financial_dev`
DATABASE_URL="postgresql://localhost:5432/financial_dev?schema=public"

# ─── Autenticação ────────────────────────────────────────────────────────────
# Lidas SOMENTE pelo seed do OWNER (prisma/seed-owner.ts).
# A sessão não usa segredo de assinatura: o token é opaco e aleatório, e o que
# vai para o banco é o hash SHA-256 dele. Não há JWT para assinar.

# Email de login do dono.
OWNER_EMAIL=

# Senha inicial, usada UMA vez para criar o OWNER (mínimo 12 caracteres).
# APAGUE esta linha depois do primeiro login — rodar o seed de novo não
# sobrescreve a senha existente, então ela não é mais necessária.
OWNER_SENHA_INICIAL=

# Nome exibido (opcional).
# OWNER_NOME=

# Código de convite do cadastro. Lido SOMENTE por
# src/infrastructure/auth/config-cadastro.ts.
#
# VAZIO OU AUSENTE = CADASTRO DESLIGADO (a rota /cadastro devolve 404). É a
# falha fechada: esquecer de configurar não abre o app para quem alcançar a
# porta. Preencha com um valor longo e aleatório e passe só a quem você quer
# convidar — cada pessoa que se cadastrar vira dona de um workspace próprio.
#   Gerar um:  openssl rand -base64 24
CADASTRO_CODIGO=

# Caminho OAuth2/Google — NÃO implementado na v1 (ver TASKS-AUTH §2.1).
# Deixado registrado para o dia em que o app deixar de ser local.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Camada de IA ────────────────────────────────────────────────────────────
# Lidas SOMENTE por src/infrastructure/ia/config-ia.ts. O domínio não as conhece.

# Liga/desliga a camada inteira. Com `false`, o app roda exatamente como antes.
IA_HABILITADA=false

# Credencial da API. Nunca commite a chave real — o .env está no .gitignore.
OPENAI_API_KEY=

# Id do modelo. Mora aqui, nunca no código.
OPENAI_MODEL=gpt-5.6-terra

# Timeout por chamada, em ms (opcional, default 60000).
# IA_TIMEOUT_MS=60000

# Tentativas por chamada, incluindo a primeira (opcional, default 2).
# IA_MAX_TENTATIVAS=2

# Reservado: `gpt-5.6-luna` é o modelo barato para categorização em massa.
# AINDA NÃO TEM CONSUMIDOR — nenhum código lê esta variável hoje.
# OPENAI_MODEL_BULK=gpt-5.6-luna
