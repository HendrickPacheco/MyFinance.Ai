// Schema do app de controle financeiro pessoal (SPEC seção 4).
//
// REGRAS INVIOLÁVEIS DESTE SCHEMA:
//  - Todo valor monetário é Int em centavos. Nunca Float/Decimal. Campo termina em `Cents`.
//  - Toda data civil é String "YYYY-MM-DD". DateTime só para createdAt/updatedAt.
//
// Deltas acordados sobre a SPEC original (rodada de perguntas):
//  - Config.destinoSobraContaId  -> aponta a conta/bucket específico que recebe a sobra (item 6)
//  - Ciclo.rolloverRecebidoCents -> sobra (±) herdada do ciclo anterior quando destino=ROLLOVER (item 5)
//  - Transacao.provisaoId (+FK)  -> marca gasto de provisão: abate acumulado e NÃO consome verba (item 3)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Singleton de configuração (id = 1 sempre).
model Config {
  // Deixou de ser singleton `id=1` na virada multi-tenant: agora é UMA Config
  // por dono. O tipo continua Int para não rippar pelo domínio inteiro; a
  // identidade real do registro é `donoId`, que é unique.
  id                   Int      @id @default(autoincrement())
  donoId               String   @unique
  dono                 Usuario  @relation(fields: [donoId], references: [id], onDelete: Cascade)
  rendaBaseCents       Int // renda LÍQUIDA (o que cai na conta)
  rendaVariavel        Boolean  @default(false)
  diaRecebimento       Int // 1-31, define o corte do ciclo
  metaPoupancaCents    Int // valor absoluto
  metaPoupancaPercent  Float? // alternativa; se preenchido, tem precedência (incide sobre a renda do mês)
  moeda                String   @default("BRL")
  timezone             String   @default("America/Bahia")
  destinoSobra         String   @default("RESERVA") // RESERVA | INVESTIMENTO | ROLLOVER
  destinoSobraContaId  String? // bucket específico que recebe a sobra (RESERVA/INVESTIMENTO)
  destinoSobraConta    Conta?   @relation(fields: [destinoSobraContaId], references: [id])
  // Piso diário configurável (regra 12): abaixo disso, a meta de poupança é
  // considerada irreal. Aviso de CONFIGURAÇÃO apenas — nunca piso no cálculo do teto.
  pisoDiarioVerbaCents Int      @default(1500)
  updatedAt            DateTime @updatedAt
}

model Conta {
  id               String  @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  nome             String
  tipo             String // FIXOS | VARIAVEL | RESERVA | INVESTIMENTO
  saldoCents       Int     @default(0)
  incluiPatrimonio Boolean @default(true)
  arquivada        Boolean @default(false)

  transacoes      Transacao[] @relation("ContaOrigem")
  transacoesDestino Transacao[] @relation("ContaDestino")
  custosFixos     CustoFixo[]
  configDestino   Config[]
  itensPatrimonio ItemPatrimonio[]

  @@index([donoId])
}

model CustoFixo {
  id            String  @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  nome          String
  valorCents    Int
  diaVencimento Int // 1-31
  ativo         Boolean @default(true)
  contaId       String?
  conta         Conta?  @relation(fields: [contaId], references: [id])

  // Vigência — hints de PROJEÇÃO FUTURA, não vigência histórica retroativa.
  // Ciclos já nascidos ignoram estes campos (são congelados: cada Ciclo guarda
  // seu próprio fixosCents). Servem para a projeção parar de contar um custo
  // que vai acabar, e é isso que faz a verba "respirar" nos meses seguintes.
  // null/null = constante para sempre (comportamento anterior à migração).
  vigenteDe     String? // YYYY-MM-DD
  vigenteAte    String? // YYYY-MM-DD

  pagamentos PagamentoFixo[]

  @@index([donoId])
}

// Rastreamento de "pago no ciclo" (coluna "Pago?" da planilha do usuário).
// É RASTREAMENTO puro: o valor do CustoFixo já foi descontado da verba quando
// o ciclo nasceu (Ciclo.fixosCents, congelado). Marcar aqui NUNCA recalcula
// nada — só existe para o usuário saber o que falta pagar no mês. Reseta
// naturalmente na virada do ciclo porque a unicidade é por (custoFixoId, cicloId).
model PagamentoFixo {
  id          String   @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  custoFixoId String
  cicloId     String
  pagoEm      String // YYYY-MM-DD — data civil em que o usuário marcou como pago
  createdAt   DateTime @default(now())

  custoFixo CustoFixo @relation(fields: [custoFixoId], references: [id])
  ciclo     Ciclo     @relation(fields: [cicloId], references: [id])

  @@unique([custoFixoId, cicloId])
  @@index([cicloId])

  @@index([donoId])
}

model ProvisaoAnual {
  id              String      @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  nome            String // "IPVA", "Presentes de Natal"
  valorAnualCents Int
  mesEsperado     Int? // 1-12, quando o gasto costuma acontecer
  acumuladoCents  Int         @default(0)
  ativo           Boolean     @default(true)
  transacoes      Transacao[]

  @@index([donoId])
}

model Categoria {
  id         String      @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  nome       String
  grupo      String // VARIAVEL | FIXO | RENDA
  essencial  Boolean     @default(false) // usado na análise de corte
  icone      String?
  cor        String?
  ordem      Int         @default(0)
  transacoes Transacao[]

  // Nome único POR DONO: dois usuários podem ter "Mercado" cada um.
  @@unique([donoId, nome])
  @@index([donoId])
}

model Transacao {
  id             String  @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  data           String // YYYY-MM-DD — data de COMPETÊNCIA (quando o gasto ocorreu)
  valorCents     Int // sempre positivo; o sinal vem do tipo
  tipo           String // DESPESA | RENDA | TRANSFERENCIA | ESTORNO
  descricao      String?
  metodo         String? // PIX | DEBITO | CREDITO | DINHEIRO | BOLETO
  categoriaId    String?
  categoria      Categoria? @relation(fields: [categoriaId], references: [id])
  contaId        String?
  conta          Conta?     @relation("ContaOrigem", fields: [contaId], references: [id])
  contaDestinoId String? // só para TRANSFERENCIA
  contaDestino   Conta?     @relation("ContaDestino", fields: [contaDestinoId], references: [id])

  // Gasto de provisão anual (item 3): se preenchido, abate acumulado e NÃO consome verba variável.
  provisaoId String?
  provisao   ProvisaoAnual? @relation(fields: [provisaoId], references: [id])

  // Parcelamento
  parcelamentoId String?
  parcelamento   Parcelamento? @relation(fields: [parcelamentoId], references: [id])
  parcelaNum     Int?

  // Estorno: aponta para a transação original
  estornoDeId String?

  cicloId   String?
  ciclo     Ciclo?   @relation(fields: [cicloId], references: [id])
  createdAt DateTime @default(now())

  // Marcação de "parcela paga" (coluna "Pago?" da planilha, aplicada à
  // parcela). RASTREAMENTO — a parcela já é uma Transacao que consome verba;
  // marcar como paga não abate nada de novo. `null` = ainda não paga.
  pagoEm String? // YYYY-MM-DD

  @@index([data])
  @@index([cicloId])
  @@index([categoriaId])
  @@index([provisaoId])

  @@index([donoId])
}

model Parcelamento {
  id              String      @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  descricao       String
  valorTotalCents Int
  numParcelas     Int
  dataCompra      String
  categoriaId     String?

  // Cancelamento antecipado: as parcelas FUTURAS foram apagadas, as já pagas
  // (e as de ciclo fechado) permanecem. Não é delete do parcelamento — a FK
  // Transacao.parcelamentoId é Restrict e as parcelas passadas seguem vivas.
  // null = em andamento.
  encerradoEm     String? // YYYY-MM-DD

  transacoes      Transacao[]

  @@index([donoId])
}

// Snapshot dos parâmetros no início do ciclo — CONGELADO (SPEC 5.2).
model Ciclo {
  id                    String  @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  dataInicio            String
  dataFim               String
  rendaPrevistaCents    Int
  rendaRealizadaCents   Int? // preenchido no fechamento (input do usuário)
  poupancaAlvoCents     Int
  fixosCents            Int // soma congelada
  provisaoMensalCents   Int // soma congelada
  verbaVariavelCents    Int // derivado e congelado
  rolloverRecebidoCents Int     @default(0) // sobra (±) herdada do ciclo anterior (destino=ROLLOVER)
  fechado               Boolean @default(false)
  fechadoEm             String?
  sobraCents            Int?
  observacao            String?
  transacoes            Transacao[]
  pagamentosFixos       PagamentoFixo[]

  @@unique([donoId, dataInicio])
  @@index([donoId])
}

model SnapshotPatrimonio {
  id         String           @id @default(cuid())
  donoId     String
  dono       Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  data       String // YYYY-MM-DD, 1 por mês
  itens      ItemPatrimonio[]
  totalCents Int

  @@unique([donoId, data])
  @@index([donoId])
}

model ItemPatrimonio {
  id         String             @id @default(cuid())
  snapshotId String
  snapshot   SnapshotPatrimonio @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  nome       String
  classe     String // CONTA | RENDA_FIXA | RENDA_VARIAVEL | CRIPTO | IMOVEL | OUTRO
  valorCents Int

  // Vínculo OPCIONAL com o razão. Item ligado a uma conta permite conciliar
  // "o que o app acha que você tem" (Conta.saldoCents, movido por transação e
  // fechamento) com "o que você observou no banco" (valorCents deste item).
  // A diferença é sinal, não erro — ver domain/finance/patrimonio.ts:
  // divergenciasConciliacao. `SetNull` porque apagar uma conta não pode apagar
  // histórico de patrimônio já fotografado.
  contaId String?
  conta   Conta?  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  @@index([contaId])
}

// ── Identidade, sessão e teto de IA (plano TASKS-AUTH) ───────────────────────
// Estes modelos são ADITIVOS: nenhuma tabela financeira acima foi alterada.
// `DateTime` aqui é timestamp de INFRAESTRUTURA (criação/expiração de sessão),
// não data civil do domínio — uso permitido pela regra de datas.

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String?
  // Argon2id. `null` = usuário sem senha local (caminho OAuth futuro);
  // no caminho atual o OWNER sempre tem senha.
  senhaHash String?
  papel     String   @default("VIEWER") // OWNER | VIEWER
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  sessoes   Sessao[]

  // Cada usuário é dono do PRÓPRIO conjunto de finanças (multi-tenant).
  // `onDelete: Cascade` do outro lado: apagar o usuário leva os dados dele.
  config          Config?
  contas          Conta[]
  categorias      Categoria[]
  custosFixos     CustoFixo[]
  pagamentosFixos PagamentoFixo[]
  provisoes       ProvisaoAnual[]
  transacoes      Transacao[]
  parcelamentos   Parcelamento[]
  ciclos          Ciclo[]
  snapshots       SnapshotPatrimonio[]
  memorias        Memoria[]
}

model Sessao {
  // `id` guarda o HASH (SHA-256) do token de sessão, NUNCA o token cru. O
  // cookie carrega o token cru; o servidor compara pelo hash. Vazar o banco
  // não entrega sessões reutilizáveis.
  id        String   @id
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
}

// Teto DURÁVEL de custo da IA. Sobrevive a restart de propósito: um teto de
// dinheiro que vive só em memória é furado por um loop de reinícios.
// Os campos são CONTAGENS (inteiros), não dinheiro — por isso sem sufixo `Cents`.
model UsoIA {
  id            String @id @default(cuid())
  dia           String @unique // YYYY-MM-DD (data civil — String, regra do schema)
  requisicoes   Int    @default(0)
  tokensEntrada Int    @default(0)
  tokensSaida   Int    @default(0)
}

/// Memória do copiloto (Fase E).
///
/// 🔴 REGRA INVIOLÁVEL: `texto` NUNCA guarda valor monetário. Um número
/// gravado aqui não tem ciclo, não tem validade e não é recalculado — ele é
/// citado amanhã como se ainda fosse verdade, e ninguém percebe. A guarda é
/// `validarTextoMemoria` em src/domain/memoria/regras.ts, aplicada antes de
/// qualquer gravação. Não existe caminho de escrita que a contorne.
///
/// Não há campo `*Cents` aqui de propósito, e não deve haver nunca.
model Memoria {
  id     String  @id @default(cuid())
  donoId String
  dono   Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)
  tipo   String // PLANO | PREFERENCIA | CONTEXTO | CONVERSA
  texto  String
  origem String  @default("USUARIO") // USUARIO | COPILOTO (proposta confirmada)
  ativo  Boolean @default(true)

  /// text-embedding-3-small, 1536 dimensões. `Unsupported` porque o Prisma não
  /// tipa vetor: leitura e escrita deste campo são SQL cru, isoladas no adapter
  /// (infrastructure/repositories/prisma-memoria.ts).
  /// Nulo = ainda não indexado; a busca semântica não o alcança (degrada, não quebra).
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([donoId, tipo, ativo])
  @@index([donoId, ativo, createdAt])
}
